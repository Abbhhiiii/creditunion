# ----- Required for cloud deployment -----

# Cloud LLM provider (Groq free tier — sign up at https://console.groq.com).
# When set, the agent uses Groq. Leave empty to fall back to local Ollama.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# JWT signing secret. MUST be set on Render to a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated origins allowed by CORS (your Vercel URLs).
# Any *.vercel.app preview is allowed automatically.
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-dashboard.vercel.app

# Render injects PORT automatically; set NODE_ENV here.
NODE_ENV=production

# ----- Local development (optional) -----

# Local Ollama (used when GROQ_API_KEY is empty).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Optional Postgres. Leave unset to run in mock-data mode (default).
# DATABASE_URL=postgresql://user:password@host:5432/creditassist
