/**
 * Environment Variables Template
 * Copy to .env and fill in your actual values
 */

# Environment
NODE_ENV=production
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/creditassist
DB_HOST=localhost
DB_PORT=5432
DB_NAME=creditassist
DB_USER=creditassist
DB_PASSWORD=your_secure_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h

# API Keys (if using external LLM APIs)
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=your-key-here

# Frontend URLs
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@creditunion.com

# AI Configuration
RAG_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=local
LLM_MODEL=llama2

# Vector DB
VECTOR_DB_TYPE=chroma
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=8000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/creditassist.log

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_VOICE_INPUT=true
ENABLE_MULTILINGUAL=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_PREDICTIVE_ALERTS=true
